# ResolveMeQ Web App Environment Variables
VITE_API_URL=http://localhost:8000
VITE_APP_NAME=ResolveMeQ
# Same Web client ID as Django GOOGLE_OAUTH_CLIENT_ID (leave unset to hide Google buttons).
# Production: ensure the SPA host sends Cross-Origin-Opener-Policy: same-origin-allow-popups
# (this repo includes public/_headers for Netlify/Cloudflare Pages; or set in CDN / nginx).
VITE_GOOGLE_CLIENT_ID=
